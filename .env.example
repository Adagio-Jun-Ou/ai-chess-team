# Ollama Cloud (https://ollama.com) - OpenAI-compatible endpoint
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=your_api_key_here

# Agent model assignments (any model id from https://ollama.com/search?c=cloud)
PARTNER_MODEL=glm-5.3-flash
OPPONENT_A_MODEL=deepseek-v4-flash:0731
OPPONENT_B_MODEL=glm-5.3-flash
AUTOPILOT_MODEL=glm-5.3-flash
NARRATOR_MODEL=glm-5.3-flash
